"""Check the installed package in a fresh process; generated by CMake."""
import hashlib
import importlib
import os
from pathlib import Path
import sys

stage = os.environ.get('DESTDIR', '')
package = Path(stage + r'@mdcraft_PYTHON_PACKAGE_ROOT@').resolve()
runtime = Path(stage + r'@mdcraft_PYTHON_LIBRARY_DIR@').resolve()
# A staged packaging install is checked within DESTDIR. Normal installs must
# import naturally from the selected interpreter, without injecting a path.
if stage:
    sys.path.insert(0, str(package.parent))
expected = @MDCRAFT_INSTALL_MODULES@
for name in expected:
    module = importlib.import_module(name)
    path = Path(module.__file__).resolve()
    if package not in path.parents:
        raise RuntimeError(f'{name} was imported from {path}, expected {package}. '
                           'Check Python_EXECUTABLE and remove stale PYTHONPATH entries.')
for name in ('EAM', 'EAMW1046', 'EAMW0644', 'EAMV1622', 'EAMWMOD1046', 'EAMWMOD0644', 'EAMMOD1044'):
    if not hasattr(importlib.import_module('mdcraft.solver.potential'), name):
        raise RuntimeError(f'Installed Python bindings are stale: missing {name}')
# Linux loaders can override RUNPATH with an older installation in LD_LIBRARY_PATH.
maps = Path('/proc/self/maps')
if maps.exists():
    loaded = {Path(line.split()[-1]).resolve() for line in maps.read_text().splitlines()
              if '/' in line and 'libmdcraft-' in line}
    def digest(path):
        with path.open('rb') as source:
            result = hashlib.sha256()
            for chunk in iter(lambda: source.read(1024 * 1024), b''):
                result.update(chunk)
            return result.digest()
    # An identical copy from the C++ lib/lib64 prefix is legitimate. Reject
    # different binaries picked up through the cluster's LD_LIBRARY_PATH.
    wrong = [str(path) for path in loaded if path.parent != runtime and
             (not (runtime / path.name).is_file() or digest(path) != digest(runtime / path.name))]
    if wrong:
        raise RuntimeError(f'Python loaded core libraries outside {runtime}: {wrong}. '
                           'Remove conflicting LD_LIBRARY_PATH entries and reinstall consistently.')
print(f'MDcraft Python install verified: {package} (interpreter: {sys.executable})')
